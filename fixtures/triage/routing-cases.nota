;; Test material only. Each case pairs a scenario label with a canned judge reply
;; that must parse under the triage output grammar. These are not live routing
;; decisions.
;;
;; Reply shape reconciled against the signal-orchestrator-judge crate types: a
;; NOTA record is a headerless positional body. The route payload is
;; `([<recipients>] <retyped-kind-option> <rewritten-message-option>)`, never
;; `(TriageRouting ...)`. Both optionals are `(Some <value>)` or the bare atom
;; `None`; a retyped kind is `(Some (Guidance <mag>))`, `(Some Interruption)`, or
;; `(Some Report)`, and a rewritten message is a full
;; `(Some (<kind> <subject> <content>))` orchestrator message, not bare text. An
;; escalation payload is the headerless `(<coordinator-reason> <detail>)`, whose
;; reason is a free-text label (not a closed atom set), never `(EscalationNote ...)`.
[
  (Case direct-route [|route to one owner, kind and payload kept|] (Route ([rust-auditor] None None)))
  (Case retype-and-rewrite [|raise a buried-urgent note and rewrite it for the recipient|] (Route ([nix-implementer] (Some Interruption) (Some (Interruption [|staging rollout breaking production|] [|stop the staging rollout immediately; it is breaking production|])))))
  (Case fanout-two-agents [|one report reaches two owners of the same topic|] (Route ([rust-auditor nix-implementer] None None)))
  (Case escalate-spawn [|no registered agent owns this work|] (Escalate (AgentSpawnNeeded [|no registered agent owns documentation; the coordinator must decide whether to spawn one|])))
  (Case reject-unregistered-sender [|the sender is not in the agent directory|] (Reject (SenderNotRegistered [|the sender stray-worker is not in the agent directory|])))
]
